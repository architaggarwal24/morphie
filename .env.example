# Locally Morphie runs with zero configuration. In production (NODE_ENV=production) it REFUSES TO START unless
# ENCRYPTION_KEY and SESSION_SECRET are set, and it never creates file-based secrets.

# Where the SQLite database, dev keys and agent workspace live. Default: ./data   (never ship this folder)
# MORPHIE_DATA_DIR=./data

# ---- Secrets (required in production: >= 32 characters each, and different from each other)
# Generate with:  openssl rand -base64 48
# ENCRYPTION_KEY encrypts provider API keys and per-user secrets (AES-256-GCM) and keys the hash of email codes.
#   Back it up: losing it makes stored provider keys unreadable. In development, random keys are generated once
#   in MORPHIE_DATA_DIR. NOTE: a key from the environment is derived differently from the dev file key, so keys
#   saved under a dev file key can't be read after switching; re-enter them.
# SESSION_SECRET: still required in production. Nothing signs with it now that the old "morphie_uid" cookie shim is
#   gone (sessions are opaque random tokens), so it is currently reserved; keep it set so your config stays valid.
# ENCRYPTION_KEY=
# SESSION_SECRET=

# ---- Public address and proxy
# The public https address of this deployment. Required in production when email or OAuth login is configured;
# OAuth redirect URIs are built from it (the Host header is never trusted for that).
# MORPHIE_PUBLIC_URL=https://morphie.example.com
# How many reverse proxies (nginx, Caddy, Cloudflare...) sit in front of Morphie: 0/false = none (default).
# true = one. The client IP is taken that many entries from the right of X-Forwarded-For, so clients can't forge it.
# Without it, per-IP limits share one "unknown" bucket (a global limit). X-Forwarded-Proto/Host are only believed when > 0.
# MORPHIE_TRUSTED_PROXY=1
# Comma-separated extra origins allowed to POST (only needed behind unusual proxies).
# MORPHIE_ALLOWED_ORIGINS=https://morphie.example.com

# ---- Abuse limits
# Requests per IP per minute.
# MORPHIE_IP_RATE_PER_MIN=600

# ---- Sessions
#There is no guest mode: you must sign in. A session ends after this many idle days, or this many days in total.
MORPHIE_SESSION_IDLE_DAYS=1
MORPHIE_SESSION_MAX_DAYS=7

# ---- Email sign-in (one-time codes). Choose one transport; leave unset to turn email sign-in off in production.
# Everything except viewing the sign-in page needs an account, so configure at least one of email, Google or GitHub.
# smtp | resend      (console prints codes to the server log and works ONLY outside production)
MORPHIE_EMAIL_TRANSPORT=smtp
MORPHIE_EMAIL_FROM="Morphie <no-reply@example.com>"
MORPHIE_SMTP_URL=smtps://user:password@smtp.example.com:465
# RESEND_API_KEY=

# ---- Google and GitHub sign-in (see README for setup). Both need MORPHIE_PUBLIC_URL in production.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# ---- Providers and tools
# Fallback web-search key (each user can also add their own in Settings → Tools). https://tavily.com
# TAVILY_API_KEY=
# Allow providers on localhost / private networks (Ollama, LM Studio). Default: true in development,
# FALSE in production. Private addresses are blocked at connect time, including after DNS changes and redirects.
# MORPHIE_ALLOW_PRIVATE_URLS=true

# ---- Limits
# MORPHIE_MAX_UPLOAD_MB=10
# MORPHIE_MAX_AGENT_STEPS=30
