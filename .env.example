# Morphie on Cloudflare: configuration reference. There is no .env file in production.
#
#   Secrets  -> `npx wrangler secret put <NAME>`        (production)   |  .dev.vars   (local; see .dev.vars.example)
#   Vars     -> "vars" in wrangler.jsonc                (non-secret)
#
# `next dev` / `npm run preview` read .dev.vars. This file only documents every variable; it is not loaded.

# --- Secrets (REQUIRED) ----------------------------------------------------------------------------------
# Encrypts provider API keys at rest (AES-256-GCM). Keep it stable: changing it makes stored keys unreadable.
ENCRYPTION_KEY=
# Signs the anonymous session cookie. Changing it logs every browser out (their data becomes unreachable).
SESSION_SECRET=

# --- Secret (optional) -----------------------------------------------------------------------------------
# Fallback web-search key (each user can also add their own in Settings -> Tools). https://tavily.com
TAVILY_API_KEY=

# --- Vars (optional; defaults shown are what wrangler.jsonc sets) ----------------------------------------
# Must stay false on Cloudflare: Workers can't reach localhost/LAN, and it blocks aiming the server at private ranges.
MORPHIE_ALLOW_PRIVATE_URLS=false
# Comma-separated extra origins allowed to POST (only for a second custom domain / unusual proxy).
# MORPHIE_ALLOWED_ORIGINS=https://morphie.example.com
MORPHIE_MAX_UPLOAD_MB=10
MORPHIE_MAX_AGENT_STEPS=30
