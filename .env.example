# Every variable is optional. Morphie runs locally with zero configuration.

# Where the SQLite database, encryption keys and agent workspace live. Default: ./data
# MORPHIE_DATA_DIR=./data

# Encrypts provider API keys at rest (AES-256-GCM) and signs session cookies.
# If unset, random keys are generated once and stored in MORPHIE_DATA_DIR (mode 0600).
# Set these explicitly for any shared or hosted deployment, and keep them stable.
# ENCRYPTION_KEY=
# SESSION_SECRET=

# Fallback web-search key (each user can also add their own in Settings → Tools). https://tavily.com
# TAVILY_API_KEY=

# Allow providers on localhost / private networks (Ollama, LM Studio, LAN gateways). Default: true.
# Set to false when hosting publicly so users can't point the server at your internal network.
# MORPHIE_ALLOW_PRIVATE_URLS=true

# Comma-separated extra origins allowed to POST (only needed behind unusual proxies).
# MORPHIE_ALLOWED_ORIGINS=https://morphie.example.com

# Limits
# MORPHIE_MAX_UPLOAD_MB=10
# MORPHIE_MAX_AGENT_STEPS=30
