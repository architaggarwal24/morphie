{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "morphie",
	// Custom entry = the OpenNext-generated Next.js handler + the Coordinator Durable Object.
	"main": "worker/index.ts",
	// Keep on or after the date you first deploy; nodejs_compat needs >= 2024-09-23.
	"compatibility_date": "2026-08-27",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	// Non-secret configuration. Secrets (ENCRYPTION_KEY, SESSION_SECRET, TAVILY_API_KEY) are NOT set here:
	// use `wrangler secret put` (see README → Deploying to Cloudflare).
	"vars": {
		// A Worker cannot reach localhost/LAN, and users must not be able to aim the server at private ranges.
		"MORPHIE_ALLOW_PRIVATE_URLS": "false",
		"MORPHIE_MAX_UPLOAD_MB": "10",
		"MORPHIE_MAX_AGENT_STEPS": "30"
		// Optional, only behind unusual proxies / custom domains on another origin:
		// "MORPHIE_ALLOWED_ORIGINS": "https://morphie.example.com"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "morphie",
			// Replace with the id printed by `npx wrangler d1 create morphie`.
			"database_id": "47188dd2-82d0-4480-8aee-1322011c644e",
			"migrations_dir": "migrations"
		},
		{
			"binding": "morphie",
			"database_name": "morphie",
			"database_id": "47188dd2-82d0-4480-8aee-1322011c644e",
			"remote": true
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "COORDINATOR",
				"class_name": "Coordinator"
			}
		]
	},
	// Current declarative form of Durable Object class lifecycle (replaces the legacy "migrations" array).
	// Older Wrangler? Use instead:  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Coordinator"] }]
	"exports": {
		"Coordinator": {
			"type": "durable-object",
			"storage": "sqlite"
		}
	}
}